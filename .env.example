# Copy this file to .env and fill in real values, then load it before
# running (e.g. `export $(cat .env | xargs)` or use python-dotenv).

# Default is SQLite (zero setup). To use real MySQL, uncomment and edit:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/tastehub

# REQUIRED in production: signs the login session cookie. Any random
# long string works - generate one with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-change-me-in-production

# Default admin account created by `python seed.py` (only if no admin
# exists yet). Change these before your first deploy.
ADMIN_EMAIL=admin@tastehub.local
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123

# Optional: powers the AI Food Assistant with real Gemini reasoning
# (get a free key at https://aistudio.google.com/apikey).
# If left unset, the assistant falls back to a rule-based recommender
# that still handles off-topic requests, unavailable-dish substitution,
# and vague cravings ("something sweet") using your real menu - the
# app works either way.
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# Optional: enables real emails for order confirmations, cancellations,
# and "item change requested" notices. Without these, emails are just
# printed to the server console (a "dry run") so the rest of the app
# keeps working during local development.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# FROM_EMAIL=your_email@gmail.com
# FROM_NAME=TasteHub

# Optional: CafeMate's spoken voice. Requires no key - it uses Microsoft's
# free edge-tts neural voices - just override which voice speaks English
# vs Malayalam. If unset, sensible defaults are used and this needs no
# configuration at all.
# TTS_VOICE_EN=en-IN-NeerjaNeural
# TTS_VOICE_ML=ml-IN-SobhanaNeural
